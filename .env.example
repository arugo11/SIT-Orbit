ORBIT_AGENT_BACKEND=fixture
ORBIT_WEB_SEARCH=off
ORBIT_BOOK_DISCOVERY=off
ORBIT_OBSERVABILITY=off
ORBIT_SCOMBZ_STUDENT_READ=off
ORBIT_SITRUS_PERSONAL_CONTEXT=off

# Managed Agent authentication uses a public Google Web application OAuth client
# whose authorized redirect URI is https://<extension-id>.chromiumapp.org/agent-auth.
# Put the project-specific value in apps/extension/.env.local (ignored by Git).
ORBIT_GOOGLE_AGENT_OAUTH_CLIENT_ID=

# Optional Chrome Extension OAuth client used by the Google Calendar connector's
# chrome.identity.getAuthToken flow. Keep this separate from the Agent client.
ORBIT_GOOGLE_EXTENSION_OAUTH_CLIENT_ID=

# Azure API configuration (the value must equal the Agent Web client ID above).
ORBIT_GOOGLE_OAUTH_CLIENT_ID=

# Azure OpenAI v1. Keep unset unless the Azure backend is explicitly selected.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-5-6-terra
# Canonical PydanticAI model profile (separate from the Azure deployment alias).
AZURE_OPENAI_BASE_MODEL=gpt-5.6-terra

# Synthetic/public demo traces only.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=sit-orbit
