ORBIT_AGENT_BACKEND=fixture
ORBIT_OBSERVABILITY=off

# Chrome Extension local build only. This is a public OAuth client ID, not a secret.
# Put the project-specific value in apps/extension/.env.local (ignored by Git).
ORBIT_GOOGLE_OAUTH_CLIENT_ID=

# Demo API only. Keep unset during normal development and CI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Azure OpenAI v1 demo only. Keep unset unless the Azure backend is explicitly selected.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=

# Synthetic/public demo traces only.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=sit-orbit
