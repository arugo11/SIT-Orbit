{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/.next",
      "!!**/.expo",
      "!!**/.venv",
      "!!**/dist",
      "!!**/node_modules",
      "!!packages/api-client/openapi.json",
      "!!packages/api-client/src/generated",
      "!!pnpm-lock.yaml",
      "!!uv.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
