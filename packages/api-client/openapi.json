{
  "openapi": "3.1.0",
  "info": {
    "title": "SIT ORBIT API",
    "description": "Personal Campus Agent for Shibaura Institute of Technology",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/actions/propose": {
      "post": {
        "summary": "Propose Action",
        "operationId": "propose_action_v1_actions_propose_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposeActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionProposal"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/actions/{action_id}/verify": {
      "post": {
        "summary": "Verify Action",
        "operationId": "verify_action_v1_actions__action_id__verify_post",
        "parameters": [
          {
            "name": "action_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Action Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrbitEvent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionProposal": {
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1,
            "title": "Action Id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "title": "Reason"
          },
          "duration_minutes": {
            "type": "integer",
            "maximum": 180.0,
            "minimum": 1.0,
            "title": "Duration Minutes"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceLink"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence"
          },
          "external_action": {
            "type": "string",
            "enum": [
              "none",
              "calendar_draft",
              "checklist_update"
            ],
            "title": "External Action",
            "default": "none"
          },
          "requires_confirmation": {
            "type": "boolean",
            "title": "Requires Confirmation",
            "default": true
          },
          "prompt_version": {
            "type": "string",
            "minLength": 1,
            "title": "Prompt Version"
          }
        },
        "type": "object",
        "required": [
          "action_id",
          "title",
          "reason",
          "duration_minutes",
          "evidence",
          "prompt_version"
        ],
        "title": "ActionProposal",
        "description": "An evidence-backed next action that remains a proposal until approved."
      },
      "EvidenceLink": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "title": "Evidence Id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "syllabus",
              "assignment",
              "learning_history",
              "calendar",
              "library"
            ],
            "title": "Source Type"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "title": "Locator"
          },
          "data_classification": {
            "type": "string",
            "enum": [
              "synthetic",
              "public",
              "personal",
              "restricted"
            ],
            "title": "Data Classification",
            "default": "synthetic"
          }
        },
        "type": "object",
        "required": [
          "evidence_id",
          "title",
          "source_type",
          "locator"
        ],
        "title": "EvidenceLink",
        "description": "A compact link to the evidence used by an action proposal."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrbitEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "campus_entered",
              "action_completed"
            ],
            "title": "Event Type"
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1,
            "title": "Scenario Id"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "campus": {
            "type": "string",
            "enum": [
              "omiya",
              "toyosu",
              "other"
            ],
            "title": "Campus"
          },
          "data_classification": {
            "type": "string",
            "enum": [
              "synthetic",
              "public",
              "personal",
              "restricted"
            ],
            "title": "Data Classification",
            "default": "synthetic"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "event_type",
          "scenario_id",
          "campus"
        ],
        "title": "OrbitEvent",
        "description": "An observed event in the student's campus journey."
      },
      "ProposeActionRequest": {
        "properties": {
          "event": {
            "$ref": "#/components/schemas/OrbitEvent"
          },
          "context": {
            "items": {
              "$ref": "#/components/schemas/EvidenceLink"
            },
            "type": "array",
            "minItems": 1,
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "event",
          "context"
        ],
        "title": "ProposeActionRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerifyActionRequest": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1,
            "title": "Scenario Id"
          },
          "campus": {
            "type": "string",
            "enum": [
              "omiya",
              "toyosu",
              "other"
            ],
            "title": "Campus"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "completed": {
            "type": "boolean",
            "title": "Completed"
          },
          "notes": {
            "type": "string",
            "maxLength": 500,
            "title": "Notes",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "scenario_id",
          "campus",
          "approved",
          "completed"
        ],
        "title": "VerifyActionRequest"
      }
    }
  }
}
