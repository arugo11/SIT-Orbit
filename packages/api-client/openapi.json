{
  "openapi": "3.1.0",
  "info": {
    "title": "SIT ORBIT API",
    "description": "Personal Campus Agent for Shibaura Institute of Technology",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agent/runs": {
      "post": {
        "summary": "Start Agent Run",
        "operationId": "start_agent_run_v1_agent_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AgentRunCompleted"
                    },
                    {
                      "$ref": "#/components/schemas/AgentRunToolRequired"
                    }
                  ],
                  "title": "Response Start Agent Run V1 Agent Runs Post",
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "completed": "#/components/schemas/AgentRunCompleted",
                      "tool_required": "#/components/schemas/AgentRunToolRequired"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agent/runs/{run_id}/tool-results": {
      "post": {
        "summary": "Submit Agent Tool Result",
        "operationId": "submit_agent_tool_result_v1_agent_runs__run_id__tool_results_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentToolResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AgentRunCompleted"
                    },
                    {
                      "$ref": "#/components/schemas/AgentRunToolRequired"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "completed": "#/components/schemas/AgentRunCompleted",
                      "tool_required": "#/components/schemas/AgentRunToolRequired"
                    }
                  },
                  "title": "Response Submit Agent Tool Result V1 Agent Runs  Run Id  Tool Results Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/actions/propose": {
      "post": {
        "summary": "Propose Action",
        "operationId": "propose_action_v1_actions_propose_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposeActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionProposal"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/actions/{action_id}/verify": {
      "post": {
        "summary": "Verify Action",
        "operationId": "verify_action_v1_actions__action_id__verify_post",
        "parameters": [
          {
            "name": "action_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Action Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrbitEvent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionProposal": {
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1,
            "title": "Action Id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "title": "Reason"
          },
          "duration_minutes": {
            "type": "integer",
            "maximum": 180.0,
            "minimum": 1.0,
            "title": "Duration Minutes"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceLink"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence"
          },
          "external_action": {
            "type": "string",
            "enum": [
              "none",
              "calendar_draft",
              "checklist_update"
            ],
            "title": "External Action",
            "default": "none"
          },
          "requires_confirmation": {
            "type": "boolean",
            "title": "Requires Confirmation",
            "default": true
          },
          "prompt_version": {
            "type": "string",
            "minLength": 1,
            "title": "Prompt Version"
          }
        },
        "type": "object",
        "required": [
          "action_id",
          "title",
          "reason",
          "duration_minutes",
          "evidence",
          "prompt_version"
        ],
        "title": "ActionProposal",
        "description": "An evidence-backed next action that remains a proposal until approved."
      },
      "AgentRunCompleted": {
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "title": "Status"
          },
          "proposal": {
            "$ref": "#/components/schemas/ActionProposal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "proposal"
        ],
        "title": "AgentRunCompleted"
      },
      "AgentRunRequest": {
        "properties": {
          "event": {
            "$ref": "#/components/schemas/OrbitEvent"
          },
          "context": {
            "items": {
              "$ref": "#/components/schemas/EvidenceLink"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Context"
          },
          "client_tools": {
            "items": {
              "$ref": "#/components/schemas/ClientTool"
            },
            "type": "array",
            "maxItems": 1,
            "title": "Client Tools"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event",
          "context"
        ],
        "title": "AgentRunRequest",
        "description": "Start one explicit proposal run.\n\n``client_tools`` is only a capability advertisement.  The server never\nuses it to access Google; a connected extension must complete the deferred\ntool call and send the minimized derived result back."
      },
      "AgentRunToolRequired": {
        "properties": {
          "status": {
            "type": "string",
            "const": "tool_required",
            "title": "Status"
          },
          "run_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Run Id"
          },
          "calls": {
            "items": {
              "$ref": "#/components/schemas/AgentToolCall"
            },
            "type": "array",
            "maxItems": 1,
            "minItems": 1,
            "title": "Calls"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "run_id",
          "calls"
        ],
        "title": "AgentRunToolRequired"
      },
      "AgentToolCall": {
        "properties": {
          "tool_call_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Tool Call Id"
          },
          "name": {
            "type": "string",
            "const": "google_calendar_availability",
            "title": "Name"
          },
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool_call_id",
          "name",
          "version"
        ],
        "title": "AgentToolCall"
      },
      "AgentToolResultRequest": {
        "properties": {
          "tool_call_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Tool Call Id"
          },
          "result": {
            "$ref": "#/components/schemas/CalendarAvailabilityResult"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool_call_id",
          "result"
        ],
        "title": "AgentToolResultRequest",
        "description": "Result for the one registered external tool."
      },
      "CalendarAvailabilityInterval": {
        "properties": {
          "start": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Start"
          },
          "end": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "End"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "CalendarAvailabilityInterval",
        "description": "One derived free-time interval, without calendar event details."
      },
      "CalendarAvailabilityResult": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "v1",
            "title": "Schema Version",
            "default": "v1"
          },
          "status": {
            "type": "string",
            "enum": [
              "known",
              "unknown",
              "reauth_required",
              "unavailable"
            ],
            "title": "Status"
          },
          "time_zone": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Time Zone"
          },
          "window_start": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Window Start"
          },
          "window_end": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Window End"
          },
          "available_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10080.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Available Minutes"
          },
          "busy_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10080.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Busy Minutes"
          },
          "free_intervals": {
            "items": {
              "$ref": "#/components/schemas/CalendarAvailabilityInterval"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Free Intervals"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "time_zone",
          "window_start",
          "window_end"
        ],
        "title": "CalendarAvailabilityResult",
        "description": "Minimal v1 result accepted from the extension's Calendar connector.\n\nEvent IDs, titles, attendees, locations, descriptions, and raw Google\nresponses deliberately have no representation in this model."
      },
      "ClientTool": {
        "properties": {
          "name": {
            "type": "string",
            "const": "google_calendar_availability",
            "title": "Name"
          },
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "title": "ClientTool",
        "description": "A capability explicitly advertised by the client for one run."
      },
      "EvidenceLink": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "title": "Evidence Id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "syllabus",
              "assignment",
              "learning_history",
              "calendar",
              "library",
              "google_drive"
            ],
            "title": "Source Type"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "title": "Locator"
          },
          "data_classification": {
            "type": "string",
            "enum": [
              "synthetic",
              "public",
              "personal",
              "restricted"
            ],
            "title": "Data Classification",
            "default": "synthetic"
          }
        },
        "type": "object",
        "required": [
          "evidence_id",
          "title",
          "source_type",
          "locator"
        ],
        "title": "EvidenceLink",
        "description": "A compact link to the evidence used by an action proposal."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrbitEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "campus_entered",
              "action_completed"
            ],
            "title": "Event Type"
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1,
            "title": "Scenario Id"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "campus": {
            "type": "string",
            "enum": [
              "omiya",
              "toyosu",
              "other"
            ],
            "title": "Campus"
          },
          "data_classification": {
            "type": "string",
            "enum": [
              "synthetic",
              "public",
              "personal",
              "restricted"
            ],
            "title": "Data Classification",
            "default": "synthetic"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "event_type",
          "scenario_id",
          "campus"
        ],
        "title": "OrbitEvent",
        "description": "An observed event in the student's campus journey."
      },
      "ProposeActionRequest": {
        "properties": {
          "event": {
            "$ref": "#/components/schemas/OrbitEvent"
          },
          "context": {
            "items": {
              "$ref": "#/components/schemas/EvidenceLink"
            },
            "type": "array",
            "minItems": 1,
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "event",
          "context"
        ],
        "title": "ProposeActionRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerifyActionRequest": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1,
            "title": "Scenario Id"
          },
          "campus": {
            "type": "string",
            "enum": [
              "omiya",
              "toyosu",
              "other"
            ],
            "title": "Campus"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "completed": {
            "type": "boolean",
            "title": "Completed"
          },
          "notes": {
            "type": "string",
            "maxLength": 500,
            "title": "Notes",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "scenario_id",
          "campus",
          "approved",
          "completed"
        ],
        "title": "VerifyActionRequest"
      }
    }
  }
}
