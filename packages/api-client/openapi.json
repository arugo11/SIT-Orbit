{
  "openapi": "3.1.0",
  "info": {
    "title": "SIT ORBIT API",
    "description": "Personal Campus Agent for Shibaura Institute of Technology",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agent/runs": {
      "post": {
        "summary": "Start Agent Run",
        "operationId": "start_agent_run_v1_agent_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AgentRunCompleted"
                    },
                    {
                      "$ref": "#/components/schemas/AgentRunToolRequired"
                    }
                  ],
                  "title": "Response Start Agent Run V1 Agent Runs Post",
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "completed": "#/components/schemas/AgentRunCompleted",
                      "tool_required": "#/components/schemas/AgentRunToolRequired"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agent/runs/{run_id}/tool-results": {
      "post": {
        "summary": "Submit Agent Tool Result",
        "operationId": "submit_agent_tool_result_v1_agent_runs__run_id__tool_results_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentToolResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AgentRunCompleted"
                    },
                    {
                      "$ref": "#/components/schemas/AgentRunToolRequired"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "completed": "#/components/schemas/AgentRunCompleted",
                      "tool_required": "#/components/schemas/AgentRunToolRequired"
                    }
                  },
                  "title": "Response Submit Agent Tool Result V1 Agent Runs  Run Id  Tool Results Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/runs": {
      "post": {
        "summary": "Start Chat Run",
        "operationId": "start_chat_run_v1_chat_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ChatRunCompleted"
                    },
                    {
                      "$ref": "#/components/schemas/ChatRunToolRequired"
                    }
                  ],
                  "title": "Response Start Chat Run V1 Chat Runs Post",
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "completed": "#/components/schemas/ChatRunCompleted",
                      "tool_required": "#/components/schemas/ChatRunToolRequired"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/runs/{run_id}/tool-results": {
      "post": {
        "summary": "Submit Chat Tool Result",
        "operationId": "submit_chat_tool_result_v1_chat_runs__run_id__tool_results_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatToolResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ChatRunCompleted"
                    },
                    {
                      "$ref": "#/components/schemas/ChatRunToolRequired"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "completed": "#/components/schemas/ChatRunCompleted",
                      "tool_required": "#/components/schemas/ChatRunToolRequired"
                    }
                  },
                  "title": "Response Submit Chat Tool Result V1 Chat Runs  Run Id  Tool Results Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/actions/propose": {
      "post": {
        "summary": "Propose Action",
        "operationId": "propose_action_v1_actions_propose_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposeActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionProposal"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/actions/{action_id}/verify": {
      "post": {
        "summary": "Verify Action",
        "operationId": "verify_action_v1_actions__action_id__verify_post",
        "parameters": [
          {
            "name": "action_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Action Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrbitEvent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionProposal": {
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1,
            "title": "Action Id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "title": "Reason"
          },
          "duration_minutes": {
            "type": "integer",
            "maximum": 180.0,
            "minimum": 1.0,
            "title": "Duration Minutes"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceLink"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence"
          },
          "external_action": {
            "type": "string",
            "enum": [
              "none",
              "calendar_draft",
              "checklist_update"
            ],
            "title": "External Action",
            "default": "none"
          },
          "requires_confirmation": {
            "type": "boolean",
            "title": "Requires Confirmation",
            "default": true
          },
          "prompt_version": {
            "type": "string",
            "minLength": 1,
            "title": "Prompt Version"
          }
        },
        "type": "object",
        "required": [
          "action_id",
          "title",
          "reason",
          "duration_minutes",
          "evidence",
          "prompt_version"
        ],
        "title": "ActionProposal",
        "description": "An evidence-backed next action that remains a proposal until approved."
      },
      "AgentRunCompleted": {
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "title": "Status"
          },
          "proposal": {
            "$ref": "#/components/schemas/ActionProposal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "proposal"
        ],
        "title": "AgentRunCompleted"
      },
      "AgentRunRequest": {
        "properties": {
          "event": {
            "$ref": "#/components/schemas/OrbitEvent"
          },
          "context": {
            "items": {
              "$ref": "#/components/schemas/EvidenceLink"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Context"
          },
          "client_tools": {
            "items": {
              "$ref": "#/components/schemas/ClientTool"
            },
            "type": "array",
            "maxItems": 2,
            "title": "Client Tools"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event",
          "context"
        ],
        "title": "AgentRunRequest",
        "description": "Start one explicit proposal run.\n\n``client_tools`` is only a capability advertisement.  The server never\nuses it to access Google; a connected extension must complete the deferred\ntool call and send the minimized derived result back."
      },
      "AgentRunToolRequired": {
        "properties": {
          "status": {
            "type": "string",
            "const": "tool_required",
            "title": "Status"
          },
          "run_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Run Id"
          },
          "calls": {
            "items": {
              "$ref": "#/components/schemas/AgentToolCall"
            },
            "type": "array",
            "maxItems": 1,
            "minItems": 1,
            "title": "Calls"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "run_id",
          "calls"
        ],
        "title": "AgentRunToolRequired"
      },
      "AgentToolCall": {
        "properties": {
          "tool_call_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Tool Call Id"
          },
          "name": {
            "type": "string",
            "enum": [
              "scombz_page_summary",
              "google_calendar_availability"
            ],
            "title": "Name"
          },
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool_call_id",
          "name",
          "version"
        ],
        "title": "AgentToolCall"
      },
      "AgentToolResultRequest": {
        "properties": {
          "tool_call_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Tool Call Id"
          },
          "name": {
            "type": "string",
            "enum": [
              "scombz_page_summary",
              "google_calendar_availability"
            ],
            "title": "Name",
            "default": "google_calendar_availability"
          },
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version",
            "default": 1
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CalendarAvailabilityResult"
              },
              {
                "$ref": "#/components/schemas/ScombzPageSummaryResult"
              }
            ],
            "title": "Result"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool_call_id",
          "result"
        ],
        "title": "AgentToolResultRequest",
        "description": "Result for one registered external tool.\n\nThe envelope repeats the call name and version so a result cannot be\naccidentally delivered to a different deferred tool.  The validator also\nkeeps the two strict result schemas from being mixed across tools."
      },
      "BrowserReadLink": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Label"
          },
          "url": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "url"
        ],
        "title": "BrowserReadLink",
        "description": "A visible link projection; it has no DOM or form state."
      },
      "BrowserReadResult": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "v1",
            "title": "Schema Version",
            "default": "v1"
          },
          "status": {
            "type": "string",
            "enum": [
              "known",
              "unavailable"
            ],
            "title": "Status"
          },
          "url": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Url"
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "title": "Title",
            "default": ""
          },
          "text": {
            "type": "string",
            "maxLength": 30000,
            "title": "Text",
            "default": ""
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/BrowserReadLink"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Links"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated",
            "default": false
          },
          "data_classification": {
            "type": "string",
            "enum": [
              "public",
              "personal"
            ],
            "title": "Data Classification",
            "default": "public"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "url"
        ],
        "title": "BrowserReadResult",
        "description": "Visible text from a user-authorized URL, bounded for model context."
      },
      "CalendarAvailabilityInterval": {
        "properties": {
          "start": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Start"
          },
          "end": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "End"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "CalendarAvailabilityInterval",
        "description": "One derived free-time interval, without calendar event details."
      },
      "CalendarAvailabilityResult": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "v1",
            "title": "Schema Version",
            "default": "v1"
          },
          "status": {
            "type": "string",
            "enum": [
              "known",
              "unknown",
              "reauth_required",
              "unavailable"
            ],
            "title": "Status"
          },
          "time_zone": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Time Zone"
          },
          "window_start": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Window Start"
          },
          "window_end": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Window End"
          },
          "available_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10080.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Available Minutes"
          },
          "busy_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10080.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Busy Minutes"
          },
          "free_intervals": {
            "items": {
              "$ref": "#/components/schemas/CalendarAvailabilityInterval"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Free Intervals"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "time_zone",
          "window_start",
          "window_end"
        ],
        "title": "CalendarAvailabilityResult",
        "description": "Minimal v1 result accepted from the extension's Calendar connector.\n\nEvent IDs, titles, attendees, locations, descriptions, and raw Google\nresponses deliberately have no representation in this model."
      },
      "ChatAssistantMessage": {
        "properties": {
          "message_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Message Id"
          },
          "content_markdown": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Content Markdown"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceLink"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_id",
          "content_markdown"
        ],
        "title": "ChatAssistantMessage"
      },
      "ChatClientTool": {
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "scombz_page_summary",
              "scombz_read",
              "google_calendar_availability",
              "syllabus_search",
              "browser_read_url"
            ],
            "title": "Name"
          },
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "title": "ChatClientTool"
      },
      "ChatHistoryMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatHistoryMessage"
      },
      "ChatRunCompleted": {
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "title": "Status"
          },
          "message": {
            "$ref": "#/components/schemas/ChatAssistantMessage"
          },
          "proposal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActionProposal"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "title": "ChatRunCompleted"
      },
      "ChatRunRequest": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Conversation Id"
          },
          "message": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Message"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatHistoryMessage"
            },
            "type": "array",
            "maxItems": 20,
            "title": "History"
          },
          "client_tools": {
            "items": {
              "$ref": "#/components/schemas/ChatClientTool"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Client Tools"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_id",
          "message"
        ],
        "title": "ChatRunRequest"
      },
      "ChatRunToolRequired": {
        "properties": {
          "status": {
            "type": "string",
            "const": "tool_required",
            "title": "Status"
          },
          "run_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Run Id"
          },
          "calls": {
            "items": {
              "$ref": "#/components/schemas/ChatToolCall"
            },
            "type": "array",
            "maxItems": 1,
            "minItems": 1,
            "title": "Calls"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "run_id",
          "calls"
        ],
        "title": "ChatRunToolRequired"
      },
      "ChatToolCall": {
        "properties": {
          "tool_call_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Tool Call Id"
          },
          "name": {
            "type": "string",
            "enum": [
              "scombz_page_summary",
              "scombz_read",
              "google_calendar_availability",
              "syllabus_search",
              "browser_read_url"
            ],
            "title": "Name"
          },
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool_call_id",
          "name",
          "version"
        ],
        "title": "ChatToolCall"
      },
      "ChatToolResultRequest": {
        "properties": {
          "tool_call_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Tool Call Id"
          },
          "name": {
